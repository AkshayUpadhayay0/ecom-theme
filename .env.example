# Copy to .env.local and fill in. Never commit real secrets.

# Required in production: a long random string (openssl rand -hex 32).
# Used to sign order-access links. Sessions are stored hashed in the database.
SESSION_SECRET=

# Public URL of the site (used for SEO, sitemap, canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shows a small "demo store" note in the footer. Set to false for a real store.
NEXT_PUBLIC_DEMO_MODE=true

# Where the SQLite database file lives. Must be a persistent disk in production.
DATABASE_DIR=./data

# Razorpay (https://dashboard.razorpay.com -> Settings -> API Keys).
# Leave empty to disable online payments; Cash on Delivery keeps working.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret (Settings -> Webhooks) for payment.captured events
RAZORPAY_WEBHOOK_SECRET=

# Optional: real hero media. Video wins over image. Leave empty for the built-in art.
NEXT_PUBLIC_HERO_VIDEO=
NEXT_PUBLIC_HERO_IMAGE=
